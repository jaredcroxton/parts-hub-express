# Site runtime variables. Production: set these in Vercel (Settings, Environment Variables), never in a committed file.
# Local testing only: copy to site/.env.local (ignored by Git). Details: architecture/payments_and_email.md

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3105
# 1 only on the real domain at launch (turns search indexing on)
SITE_LIVE=

# Stripe (use test keys first: rk_test_ or sk_test_, then live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 only when Stripe Tax is set up for Australian GST
STRIPE_AUTOMATIC_TAX=0
# optional, comma separated shipping rate ids
STRIPE_SHIPPING_RATE_IDS=

# Odoo (stock check at checkout and paid order push)
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
ODOO_TRANSPORT=
ODOO_PRICES_INCLUDE_GST=0
ODOO_CONFIRM_PAID_ORDERS=0
ALLOW_BACKORDER=0

# Resend
RESEND_API_KEY=
ORDER_FROM_EMAIL=Parts Hub Express <orders@partshubexpress.com>
ENQUIRY_TO_EMAIL=
ORDER_NOTIFY_EMAIL=
RESEND_AUDIENCE_ID=
