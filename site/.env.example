# Parts Hub Express: the keys the live site needs, and where to get each one.
# Fill them in, then paste the whole file into Vercel: Project, Settings, Environment Variables.
# Never commit a filled-in copy. Lines starting with # are notes.
# Local testing: copy to site/.env.local (ignored by Git) and use http://localhost:3105 as the site address.

# ---------- 1. SITE ----------
# The address customers use.
NEXT_PUBLIC_SITE_URL=https://partshubexpress.com
# Leave empty until launch day. 1 lets Google index the site.
# The build stops if this is 1 while site/lib/company.ts still has the placeholder phone and email.
SITE_LIVE=

# ---------- 2. STRIPE (card payments) ----------
# Stripe Dashboard, Developers, API keys, "Secret key". Starts with sk_live_ (sk_test_ while testing).
# No publishable key is needed.
STRIPE_SECRET_KEY=
# Stripe Dashboard, Developers, Webhooks, Add endpoint.
#   Endpoint URL: https://partshubexpress.com/api/stripe/webhook
#   Events: checkout.session.completed and checkout.session.async_payment_succeeded
# Then copy that endpoint's "Signing secret". Starts with whsec_.
STRIPE_WEBHOOK_SECRET=
# Leave at 0 unless Stripe Tax is set up for Australian GST (then 1).
STRIPE_AUTOMATIC_TAX=0
# Optional. Stripe shipping rate ids, comma separated. Empty means freight is confirmed after the order.
STRIPE_SHIPPING_RATE_IDS=

# ---------- 3. RESEND (emails the site sends) ----------
# Resend, API Keys, Create API key, permission "Sending access". Starts with re_.
RESEND_API_KEY=
# The address emails come from. Its domain must be verified in Resend first:
# Resend, Domains, Add domain partshubexpress.com, then add the DNS records it lists at Crazy Domains.
ORDER_FROM_EMAIL=Parts Hub Express <orders@partshubexpress.com>
# The inbox that receives quote requests and trade applications.
ENQUIRY_TO_EMAIL=
# The inbox that receives order notices and alerts. Empty means the enquiry inbox gets them.
ORDER_NOTIFY_EMAIL=
# Optional. Resend, Audiences, the audience id for the email signup box.
RESEND_AUDIENCE_ID=

# ---------- 4. ODOO (prices, stock, orders) ----------
# Until these are in, no part has a price, so every part is quote only and Stripe has nothing to charge.
# The first six also go into GitHub for the nightly sync: Settings, Secrets and variables, Actions.
# ODOO_PRICES_INCLUDE_GST goes under Variables, the other five under Secrets.
# The Odoo address with nothing after .com, for example https://yourcompany.odoo.com
ODOO_URL=
# The database name. On Odoo Online it is the first part of the address.
ODOO_DB=
# The login email of the Odoo user the API key belongs to.
ODOO_LOGIN=
# Odoo, that user's Preferences, Account Security, New API Key. Lasts three months at most.
ODOO_API_KEY=
# json2 for Odoo 19 or later, jsonrpc for Odoo 17 and 18.
ODOO_TRANSPORT=json2
# 0 when Odoo prices exclude GST (the site adds 10 percent), 1 when they include it.
ODOO_PRICES_INCLUDE_GST=0
# 0 leaves paid orders as quotations for the team to confirm, 1 confirms them automatically.
ODOO_CONFIRM_PAID_ORDERS=0
# 0 stops checkout when a part is short on stock, 1 allows backorders.
ALLOW_BACKORDER=0
