# Parts Hub Express credentials, for the Python tools run on a local machine. Copy to .env and fill in. Never commit .env.
# Production values live in Vercel (site runtime) and GitHub Actions (nightly sync), not in files.
# Full list and where each one goes: architecture/payments_and_email.md

# Odoo (nightly sync, stock check, order push). API keys expire within 3 months: rotate on a calendar.
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
# json2 for Odoo 19 and later, jsonrpc for Odoo 17 and 18
ODOO_TRANSPORT=
# 0 when Odoo list prices exclude GST (Australian default), 1 when they include it
ODOO_PRICES_INCLUDE_GST=0

# Stripe and Resend, only needed here for tools/handshake_stripe.py and tools/handshake_resend.py
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
ORDER_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
